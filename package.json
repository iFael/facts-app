{
  "name": "facts-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "tsc --noEmit && next build",
    "start": "next start -H 127.0.0.1",
    "preview": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:schema",
    "test:schema": "node --test tests/schema/*.test.mjs",
    "test:e2e": "playwright test",
    "predev": "node scripts/prepare-assets.mjs && node scripts/generate-service-worker.mjs",
    "prebuild": "node scripts/prepare-assets.mjs && node scripts/generate-service-worker.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "dexie": "4.4.6",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fake-indexeddb": "6.2.5",
    "postcss": "^8.5.28",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
